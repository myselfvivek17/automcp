# Application Settings
ENVIRONMENT=development
DEBUG=true
APP_NAME=AutoMCP
APP_VERSION=1.0.0
API_HOST=0.0.0.0
API_PORT=8000

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
ENCRYPTION_KEY=your-32-byte-encryption-key-change-this
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Database - IBM Cloudant
CLOUDANT_URL=https://your-account.cloudant.com
CLOUDANT_USERNAME=your-username
CLOUDANT_PASSWORD=your-password
CLOUDANT_DATABASE=automcp

# Redis (for caching and rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# IBM watsonx.ai
WATSONX_API_KEY=your-watsonx-api-key
WATSONX_PROJECT_ID=your-project-id
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL=ibm/granite-13b-chat-v2

# OpenAI (optional)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_ORG_ID=

# Anthropic (optional)
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-opus-20240229

# Google Gemini (optional)
GOOGLE_API_KEY=your-google-api-key
GOOGLE_MODEL=gemini-pro

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600

# File Upload
MAX_UPLOAD_SIZE_MB=10
ALLOWED_FILE_TYPES=.json,.yaml,.yml,.txt

# Agent System
MAX_CONCURRENT_AGENTS=5
AGENT_TIMEOUT_SECONDS=300
AGENT_RETRY_ATTEMPTS=3

# Code Generation
OUTPUT_LANGUAGES=python,typescript
DEFAULT_OUTPUT_LANGUAGE=python
TEMPLATE_DIRECTORY=./templates

# WebSocket
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=100

# Monitoring (optional)
SENTRY_DSN=
DATADOG_API_KEY=

# IBM Cloud (for deployment)
IBM_CLOUD_API_KEY=
IBM_CLOUD_REGION=us-south
CODE_ENGINE_PROJECT=automcp